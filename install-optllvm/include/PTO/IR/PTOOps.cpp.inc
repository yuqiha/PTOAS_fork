    auto valueGroup0 = getODSOperands(0);

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_PTOOps11(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
