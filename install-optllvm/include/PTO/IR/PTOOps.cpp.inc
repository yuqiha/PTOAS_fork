void TMovOp::print(::mlir::OpAsmPrinter &_odsPrinter) {
  _odsPrinter << ' ' << "ins";
  _odsPrinter << "(";
  _odsPrinter << getSrc();
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
   _odsPrinter << getSrc().getType();
  if (getFp()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    if (::mlir::Value value = getFp())
      _odsPrinter << value;
    _odsPrinter << ' ' << ":";
    _odsPrinter << ' ';
    _odsPrinter << (getFp() ? ::llvm::ArrayRef<::mlir::Type>(getFp().getType()) : ::llvm::ArrayRef<::mlir::Type>());
  }
  if (getPreQuantScalar()) {
    _odsPrinter << ",";
    _odsPrinter << ' ';
    if (::mlir::Value value = getPreQuantScalar())
      _odsPrinter << value;
    _odsPrinter << ' ' << ":";
    _odsPrinter << ' ';
    _odsPrinter << (getPreQuantScalar() ? ::llvm::ArrayRef<::mlir::Type>(getPreQuantScalar().getType()) : ::llvm::ArrayRef<::mlir::Type>());
  }
  _odsPrinter << ")";
  _odsPrinter << ' ' << "outs";
  _odsPrinter << "(";
  _odsPrinter << getDst();
  _odsPrinter << ' ' << ":";
  _odsPrinter << ' ';
   _odsPrinter << getDst().getType();
  _odsPrinter << ")";
  ::llvm::SmallVector<::llvm::StringRef, 2> elidedAttrs;
  elidedAttrs.push_back("operandSegmentSizes");
  {
     ::mlir::Builder odsBuilder(getContext());
     ::mlir::Attribute attr = getReluPreModeAttr();
     if(attr && (attr == ::mlir::pto::ReluPreModeAttr::get(odsBuilder.getContext(), ::mlir::pto::ReluPreMode::NoRelu)))
       elidedAttrs.push_back("reluPreMode");
  }
  _odsPrinter.printOptionalAttrDict((*this)->getAttrs(), elidedAttrs);
  if (getResult()) {
    _odsPrinter << ' ' << "->";
    _odsPrinter << ' ';
    _odsPrinter << (getResult() ? ::llvm::ArrayRef<::mlir::Type>(getResult().getType()) : ::llvm::ArrayRef<::mlir::Type>());
  }
}

