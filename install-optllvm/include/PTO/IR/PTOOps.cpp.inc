  auto tblgen_rmode = getProperties().rmode; (void)tblgen_rmode;
  auto tblgen_sat_mode = getProperties().sat_mode; (void)tblgen_sat_mode;

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps20(*this, tblgen_rmode, "rmode")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps21(*this, tblgen_sat_mode, "sat_mode")))
    return ::mlir::failure();
  {
