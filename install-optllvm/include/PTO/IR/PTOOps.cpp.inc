    return ::mlir::failure();
  if (parser.resolveOperands(valid_rowOperands, odsBuildableType1, valid_rowOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(valid_colOperands, odsBuildableType1, valid_colOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

