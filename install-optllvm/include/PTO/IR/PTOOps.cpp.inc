  auto tblgen_dir_mask = getProperties().dir_mask; (void)tblgen_dir_mask;
  if (!tblgen_dir_mask) return emitOpError("requires attribute 'dir_mask'");
  auto tblgen_id = getProperties().id; (void)tblgen_id;
  auto tblgen_local_slot_num = getProperties().local_slot_num; (void)tblgen_local_slot_num;
  auto tblgen_nosplit = getProperties().nosplit; (void)tblgen_nosplit;
  auto tblgen_slot_size = getProperties().slot_size; (void)tblgen_slot_size;
  if (!tblgen_slot_size) return emitOpError("requires attribute 'slot_size'");

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps0(*this, tblgen_id, "id")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps1(*this, tblgen_dir_mask, "dir_mask")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps0(*this, tblgen_slot_size, "slot_size")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps0(*this, tblgen_local_slot_num, "local_slot_num")))
    return ::mlir::failure();

  if (::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps2(*this, tblgen_nosplit, "nosplit")))
    return ::mlir::failure();
  {
    unsigned index = 0; (void)index;
    auto valueGroup0 = getODSOperands(0);

    if (valueGroup0.size() > 1) {
      return emitOpError("operand group starting at #") << index
          << " requires 0 or 1 element, but found " << valueGroup0.size();
    }

    for (auto v : valueGroup0) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_PTOOps0(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup1 = getODSOperands(1);

    for (auto v : valueGroup1) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_PTOOps2(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
    auto valueGroup2 = getODSOperands(2);

    for (auto v : valueGroup2) {
      if (::mlir::failed(__mlir_ods_local_type_constraint_PTOOps2(*this, v.getType(), "operand", index++)))
        return ::mlir::failure();
    }
  }
  return ::mlir::success();
}

