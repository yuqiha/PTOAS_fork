    {
      ::mlir::Attribute attr = attrs.get(getKindAttrName(opName));
      if (attr && ::mlir::failed(__mlir_ods_local_attr_constraint_PTOOps14(attr, "kind", emitError)))
        return ::mlir::failure();
    }
    return ::mlir::success();
}

