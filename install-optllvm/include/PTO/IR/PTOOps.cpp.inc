::llvm::LogicalResult VpackOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_part = getProperties().part; (void)tblgen_part;
  if (!tblgen_part) return emitError(loc, "'pto.vpack' op ""requires attribute 'part'");

  if (tblgen_part && !((::llvm::isa<::mlir::StringAttr>(tblgen_part))))
    return emitError(loc, "'pto.vpack' op ""attribute 'part' failed to satisfy constraint: string attribute");
  return ::mlir::success();
}

::llvm::LogicalResult VpackOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.part;
       auto attr = dict.get("part");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `part` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute VpackOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.part;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("part",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code VpackOp::computePropertiesHash(const Properties &prop) {
  return llvm::hash_combine(
    llvm::hash_value(prop.part.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> VpackOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "part")
