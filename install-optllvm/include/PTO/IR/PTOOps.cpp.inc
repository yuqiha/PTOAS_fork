::llvm::LogicalResult MemBarOpAdaptor::verify(::mlir::Location loc) {
  auto tblgen_kind = getProperties().kind; (void)tblgen_kind;
  if (!tblgen_kind) return emitError(loc, "'pto.mem_bar' op ""requires attribute 'kind'");

  if (tblgen_kind && !((::llvm::isa<::mlir::pto::MemBarAttr>(tblgen_kind))))
    return emitError(loc, "'pto.mem_bar' op ""attribute 'kind' failed to satisfy constraint: ");
  return ::mlir::success();
