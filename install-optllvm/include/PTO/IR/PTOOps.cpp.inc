  return std::nullopt;
}

void VpackOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "part") {
       prop.part = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.part)>>(value);
       return;
    }
}

void VpackOp::populateInherentAttrs(::mlir::MLIRContext *ctx, const Properties &prop, ::mlir::NamedAttrList &attrs) {
    if (prop.part) attrs.append("part", prop.part);
}

