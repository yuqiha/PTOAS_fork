::llvm::LogicalResult TStoreOp::setPropertiesFromAttr(Properties &prop, ::mlir::Attribute attr, ::llvm::function_ref<::mlir::InFlightDiagnostic()> emitError) {
  ::mlir::DictionaryAttr dict = ::llvm::dyn_cast<::mlir::DictionaryAttr>(attr);
  if (!dict) {
    emitError() << "expected DictionaryAttr to set properties";
    return ::mlir::failure();
  }

  {
    auto &propStorage = prop.atomicType;
       auto attr = dict.get("atomicType");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `atomicType` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.reluPreMode;
       auto attr = dict.get("reluPreMode");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `reluPreMode` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }

  {
    auto &propStorage = prop.stPhase;
       auto attr = dict.get("stPhase");
    if (attr) {
      auto convertedAttr = ::llvm::dyn_cast<std::remove_reference_t<decltype(propStorage)>>(attr);
      if (convertedAttr) {
        propStorage = convertedAttr;
      } else {
        emitError() << "Invalid attribute `stPhase` in property conversion: " << attr;
        return ::mlir::failure();
      }
    }
  }
  return ::mlir::success();
}

::mlir::Attribute TStoreOp::getPropertiesAsAttr(::mlir::MLIRContext *ctx, const Properties &prop) {
    ::mlir::SmallVector<::mlir::NamedAttribute> attrs;
    ::mlir::Builder odsBuilder{ctx};

    {
      const auto &propStorage = prop.atomicType;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("atomicType",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.reluPreMode;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("reluPreMode",
                                       propStorage));
    }

    {
      const auto &propStorage = prop.stPhase;
      if (propStorage)
        attrs.push_back(odsBuilder.getNamedAttr("stPhase",
                                       propStorage));
    }

  if (!attrs.empty())
    return odsBuilder.getDictionaryAttr(attrs);
  return {};
}

llvm::hash_code TStoreOp::computePropertiesHash(const Properties &prop) {
  return llvm::hash_combine(
    llvm::hash_value(prop.atomicType.getAsOpaquePointer()), 
    llvm::hash_value(prop.reluPreMode.getAsOpaquePointer()), 
    llvm::hash_value(prop.stPhase.getAsOpaquePointer()));
}

std::optional<mlir::Attribute> TStoreOp::getInherentAttr(::mlir::MLIRContext *ctx, const Properties &prop, llvm::StringRef name) {
    if (name == "atomicType")
      return prop.atomicType;

    if (name == "reluPreMode")
      return prop.reluPreMode;

    if (name == "stPhase")
      return prop.stPhase;
  return std::nullopt;
}

void TStoreOp::setInherentAttr(Properties &prop, llvm::StringRef name, mlir::Attribute value) {
    if (name == "atomicType") {
       prop.atomicType = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.atomicType)>>(value);
       return;
    }

    if (name == "reluPreMode") {
       prop.reluPreMode = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.reluPreMode)>>(value);
       return;
    }

    if (name == "stPhase") {
       prop.stPhase = ::llvm::dyn_cast_or_null<std::remove_reference_t<decltype(prop.stPhase)>>(value);
