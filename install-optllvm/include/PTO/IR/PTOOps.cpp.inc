::mlir::ParseResult BuildAsyncSessionOp::parse(::mlir::OpAsmParser &parser, ::mlir::OperationState &result) {
  ::mlir::OpAsmParser::UnresolvedOperand scratchRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> scratchOperands(&scratchRawOperand, 1);  ::llvm::SMLoc scratchOperandsLoc;
  (void)scratchOperandsLoc;
  ::mlir::OpAsmParser::UnresolvedOperand workspaceRawOperand{};
  ::llvm::ArrayRef<::mlir::OpAsmParser::UnresolvedOperand> workspaceOperands(&workspaceRawOperand, 1);  ::llvm::SMLoc workspaceOperandsLoc;
  (void)workspaceOperandsLoc;
  ::mlir::Type scratchRawType{};
  ::llvm::ArrayRef<::mlir::Type> scratchTypes(&scratchRawType, 1);
  ::mlir::Type workspaceRawType{};
  ::llvm::ArrayRef<::mlir::Type> workspaceTypes(&workspaceRawType, 1);
  ::mlir::Type sessionRawType{};
  ::llvm::ArrayRef<::mlir::Type> sessionTypes(&sessionRawType, 1);
  if (parser.parseLParen())
    return ::mlir::failure();

  scratchOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(scratchRawOperand))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  workspaceOperandsLoc = parser.getCurrentLocation();
  if (parser.parseOperand(workspaceRawOperand))
    return ::mlir::failure();
  if (parser.parseColon())
    return ::mlir::failure();

  if (parser.parseType(scratchRawType))
    return ::mlir::failure();
  if (parser.parseComma())
    return ::mlir::failure();

  {
    ::mlir::Type type;
    if (parser.parseCustomTypeWithFallback(type))
      return ::mlir::failure();
    workspaceRawType = type;
  }
  if (parser.parseRParen())
    return ::mlir::failure();
  {
    auto loc = parser.getCurrentLocation();(void)loc;
    if (parser.parseOptionalAttrDict(result.attributes))
      return ::mlir::failure();
    if (failed(verifyInherentAttrs(result.name, result.attributes, [&]() {
        return parser.emitError(loc) << "'" << result.name.getStringRef() << "' op ";
      })))
      return ::mlir::failure();
  }
  if (parser.parseArrow())
    return ::mlir::failure();

  if (parser.parseType(sessionRawType))
    return ::mlir::failure();
  result.addTypes(sessionTypes);
  if (parser.resolveOperands(scratchOperands, scratchTypes, scratchOperandsLoc, result.operands))
    return ::mlir::failure();
  if (parser.resolveOperands(workspaceOperands, workspaceTypes, workspaceOperandsLoc, result.operands))
    return ::mlir::failure();
  return ::mlir::success();
}

