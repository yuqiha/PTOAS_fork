// Test i8*i8->i32 matmul
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @test_i8_mad(
      %lhs: !pto.ptr<i8, l0a>,
      %rhs: !pto.ptr<i8, l0b>,
      %dst: !pto.ptr<i32, l0c>) attributes {pto.aicore} {
    %c16 = arith.constant 16 : i64
    pto.mad %lhs, %rhs, %dst, %c16, %c16, %c16
      : !pto.ptr<i8, l0a>, !pto.ptr<i8, l0b>, !pto.ptr<i32, l0c>, i64, i64, i64
    return
  }
}