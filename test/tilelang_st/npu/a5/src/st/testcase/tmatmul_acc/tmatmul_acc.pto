// TileLang ST kernel for cube matmul - splitk accumulate only.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {

  // case3: f16, 127x128x61 splitk - stub
  func.func @TMATMUL_case3_f16_127x128x61_splitk(%a_gm: !pto.ptr<f16, gm>, %b_gm: !pto.ptr<f16, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }

  // case_bias_5: f32, 127x128x63 splitk - stub
  func.func @TMATMUL_BIAS_case_bias_5_f32_127x128x63_splitk(%a_gm: !pto.ptr<f32, gm>, %b_gm: !pto.ptr<f32, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }

  // case_bias_11: f16, 1x512x85 gemv splitk - stub
  func.func @TMATMUL_BIAS_case_bias_11_f16_1x512x85_gemv_splitk(%a_gm: !pto.ptr<f16, gm>, %b_gm: !pto.ptr<f16, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
}