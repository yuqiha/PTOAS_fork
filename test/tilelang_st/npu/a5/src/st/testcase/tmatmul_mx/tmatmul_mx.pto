// TileLang ST kernel for cube matmul mx (mixed precision with scaling).
// NOTE: FP8 MX types not supported in tilelang_st level3 path, using f16 as placeholder.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @TMATMUL_MX_f16_16x16x16(%a_gm: !pto.ptr<f16, gm>, %b_gm: !pto.ptr<f16, gm>, %scale_a_gm: !pto.ptr<f16, gm>, %scale_b_gm: !pto.ptr<f16, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} {
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c16_i64 = arith.constant 16 : i64
    %c32_i64 = arith.constant 32 : i64
    %c512_i64 = arith.constant 512 : i64
    %false = arith.constant false

    %l1_a_tile = pto.alloc_tile addr = %c0_i64
      : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
    %l1_b_tile = pto.alloc_tile addr = %c512_i64
      : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
    %l0a_tile = pto.alloc_tile addr = %c0_i64
      : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major>
    %l0b_tile = pto.alloc_tile addr = %c0_i64
      : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major>
    %l0c_tile = pto.alloc_tile addr = %c0_i64
      : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major>

    %l1_a = pto.tile_buf_addr %l1_a_tile
      : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
     -> !pto.ptr<f16, l1>
    %l1_b = pto.tile_buf_addr %l1_b_tile
      : !pto.tile_buf<mat, 16x16xf16, blayout=col_major, slayout=row_major>
     -> !pto.ptr<f16, l1>
    %l0a = pto.tile_buf_addr %l0a_tile
      : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major>
     -> !pto.ptr<f16, l0a>
    %l0b = pto.tile_buf_addr %l0b_tile
      : !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major>
     -> !pto.ptr<f16, l0b>
    %l0c = pto.tile_buf_addr %l0c_tile
      : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major>
     -> !pto.ptr<f32, l0c>

    pto.mte_gm_l1_frac %a_gm, %l1_a, nd2nz,
      shape(%c16_i64, %c16_i64),
      src_layout(%c32_i64),
      dst_group(%c1_i64, %c1_i64, %c16_i64, %c0_i64),
      ctrl(%c0_i64, %false)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, l1>, nd2nz,
        shape i64, i64, src_layout(i64),
        dst_group i64, i64, i64, i64, ctrl i64, i1

    pto.mte_gm_l1_frac %b_gm, %l1_b, nd2nz,
      shape(%c16_i64, %c16_i64),
      src_layout(%c32_i64),
      dst_group(%c1_i64, %c1_i64, %c16_i64, %c0_i64),
      ctrl(%c0_i64, %false)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, l1>, nd2nz,
        shape i64, i64, src_layout(i64),
        dst_group i64, i64, i64, i64, ctrl i64, i1

    pto.set_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_MTE1", "EVENT_ID0"]

    pto.mte_l1_l0a %l1_a, %l0a, %c16_i64, %c16_i64
      : !pto.ptr<f16, l1>, !pto.ptr<f16, l0a>, i64, i64

    pto.mte_l1_l0b %l1_b, %l0b, %c16_i64, %c16_i64 {transpose = true}
      : !pto.ptr<f16, l1>, !pto.ptr<f16, l0b>, i64, i64

    pto.set_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE1", "PIPE_M", "EVENT_ID0"]

    pto.tmatmul ins(%l0a_tile, %l0b_tile : !pto.tile_buf<left, 16x16xf16, blayout=col_major, slayout=row_major>,
                                         !pto.tile_buf<right, 16x16xf16, blayout=row_major, slayout=col_major>)
                 outs(%l0c_tile : !pto.tile_buf<acc, 16x16xf32, blayout=col_major, slayout=row_major>)

    pto.set_flag["PIPE_M", "PIPE_FIX", "EVENT_ID1"]
    pto.wait_flag["PIPE_M", "PIPE_FIX", "EVENT_ID1"]

    pto.mte_l0c_gm %l0c, %c_gm, %c16_i64, %c16_i64, %c16_i64, %c16_i64, %c0_i64, %c0_i64, nz2nd
      : !pto.ptr<f32, l0c>, !pto.ptr<f32, gm>, i64, i64, i64, i64, i64, i64

    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }

  // Stub implementations for other cases
  func.func @TMATMUL_MX_fp8_e4m3_127x72x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp8_e4m3_e5m2_128x110x63(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp8_e5m2_128x64x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp4_e2m1_128x64x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp4_e1m2_e2m1_117x64x60(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp4_e2m1_e1m2_128x118x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp4_e2m1_e1m2_115x64x30(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp8_e4m3_16x32x16(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp8_e4m3_e5m2_10x50x54(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_fp4_e2m1_4x30x8(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_gemv_fp4_e1m2_1x128x62(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_gemv_fp8_e4m3_e5m2_1x256x20(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_fp8_e5m2_e4m3_115x64x30(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_fp8_e4m3_200x192x95(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_fp4_e2m1_e1m2_35x128x56(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_fp4_e1m2_47x128x62(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_fp8_e4m3_e5m2_64x192x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_gemv_fp4_e1m2_1x64x62(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
  func.func @TMATMUL_MX_bias_gemv_fp4_e1m2_1x2048x64(%a_gm: !pto.ptr<i8, gm>, %b_gm: !pto.ptr<i8, gm>, %scale_a_gm: !pto.ptr<i8, gm>, %scale_b_gm: !pto.ptr<i8, gm>, %bias_gm: !pto.ptr<f32, gm>, %c_gm: !pto.ptr<f32, gm>) attributes {pto.aicore} { return }
}